{
  "name": "nestify",
  "displayName": "Nestify — JSON Flatten & Nest",
  "description": "Flatten nested JSON into dot-joined keys and nest it back again — from the editor toolbar, the right-click menu, or the Command Palette.",
  "version": "0.0.5",
  "publisher": "GiorgiLazareshvili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazogio/Nestify.git"
  },
  "bugs": {
    "url": "https://github.com/lazogio/Nestify/issues"
  },
  "homepage": "https://github.com/lazogio/Nestify#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#5B5BF0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json",
    "flatten",
    "unflatten",
    "nest",
    "i18n"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "nestify.flatten",
        "title": "Flatten JSON",
        "category": "Nestify",
        "icon": "$(list-flat)"
      },
      {
        "command": "nestify.unflatten",
        "title": "Unflatten (Nest) JSON",
        "category": "Nestify",
        "icon": "$(list-tree)"
      },
      {
        "command": "nestify.convert",
        "title": "Convert With…",
        "category": "Nestify",
        "icon": "$(json)"
      },
      {
        "command": "nestify.runConverter",
        "title": "Run Converter",
        "category": "Nestify"
      },
      {
        "command": "nestify.copyConverted",
        "title": "Copy Converted…",
        "category": "Nestify",
        "icon": "$(clippy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nestify",
          "title": "Nestify",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "views": {
      "nestify": [
        {
          "id": "nestify.converters",
          "name": "Nestify",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "nestify.submenu",
        "label": "Nestify",
        "icon": "$(json)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nestify.flatten",
          "when": "editorIsOpen"
        },
        {
          "command": "nestify.unflatten",
          "when": "editorIsOpen"
        },
        {
          "command": "nestify.convert",
          "when": "editorIsOpen"
        },
        {
          "command": "nestify.runConverter",
          "when": "false"
        },
        {
          "command": "nestify.copyConverted",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "submenu": "nestify.submenu",
          "when": "editorTextFocus",
          "group": "1_modification@10"
        }
      ],
      "nestify.submenu": [
        {
          "command": "nestify.flatten",
          "group": "nestify@10"
        },
        {
          "command": "nestify.unflatten",
          "group": "nestify@20"
        },
        {
          "command": "nestify.convert",
          "group": "nestify@30"
        },
        {
          "command": "nestify.copyConverted",
          "group": "nestify@40"
        }
      ],
      "view/item/context": [
        {
          "command": "nestify.copyConverted",
          "when": "view == nestify.converters",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "nestify.flatten",
          "when": "view == nestify.converters",
          "group": "navigation@10"
        },
        {
          "command": "nestify.unflatten",
          "when": "view == nestify.converters",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "nestify.flatten",
          "when": "resourceLangId == json",
          "group": "navigation@10"
        },
        {
          "command": "nestify.unflatten",
          "when": "resourceLangId == json",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "Nestify",
      "properties": {
        "nestify.separator": {
          "type": "string",
          "default": ".",
          "description": "Separator used to join and split nested key paths."
        },
        "nestify.indent": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of spaces used to indent the JSON that Nestify writes back."
        },
        "nestify.arrays": {
          "type": "string",
          "enum": [
            "rebuild",
            "objects"
          ],
          "enumDescriptions": [
            "Keys that are exactly the indices 0…n-1 become the array they were flattened from.",
            "Every container stays an object, so index-like keys are kept as keys."
          ],
          "default": "rebuild",
          "description": "What nesting does with keys that are consecutive indices from zero."
        },
        "nestify.sortKeys": {
          "type": "boolean",
          "default": false,
          "description": "Write the converted JSON with each object's keys in order."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
